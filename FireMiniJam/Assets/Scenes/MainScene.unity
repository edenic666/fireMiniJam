  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64bb88490d9ae8b49a4cbc770ae2ea43, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  textComponent: {fileID: 46962598}
  dialogueBox: {fileID: 1403475073}
  dialogueChangeEvent: 2
  linesBefore:
  - "Light Bringer\u2026 The torch here has been blocked by a puzzle."
  - "I seem unable to solve it myself, despite my best efforts to have things prepared
    for your arrival. I\u2019ve reset it for you to begin."
  - "Shame, I think I was just getting the hang of it! I\u2019m feeling pretty strongly
    about Heart being the first one."
  linesAfter:
  - Oh wow!
  - You solved it, I knew you could do it, Light Bringer!
  player: {fileID: 1869413783}
  textSpeed: 0.05
  dialogueActive: 0
