  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  textComponent: {fileID: 46962598}
  dialogueBox: {fileID: 1403475073}
  dialogueChangeEvent: 1
  linesBefore:
  - Oh, Light Bringer, finally!
  - "This torch is blocked by a key and I\u2019m unable to obtain it, stuck here
    as I am."
  - Once you obtain it, you can open the path to the torch and light it for us!
  - Oh and free me as well, hopefully!
  linesAfter:
  - Thank you, oh, thank you, Light Bringer!
  - "You\u2019ve brought LIGHT to my floor and freed me at the same time!"
  player: {fileID: 1869413783}
  textSpeed: 0.05
  dialogueActive: 0
